# ============================================================================
# Chrome Fleet Control — environment configuration
# ----------------------------------------------------------------------------
# Copy this file to ".env" and adjust the values, then start with ./run.sh
#   cp .env.example .env
# run.sh will also auto-create .env from this file on first launch if missing.
# ============================================================================

# --- Authentication (REQUIRED) ----------------------------------------------
# Basic-Auth credentials for the dashboard UI and the legacy /api/* endpoints.
# The server refuses to start if either of these is empty.
CHROME_FLEET_USERNAME=admin
CHROME_FLEET_PASSWORD=secret

# --- Server ------------------------------------------------------------------
# Port the dashboard/HTTP server listens on (binds 0.0.0.0).
PORT=3000

# --- REST API (optional) -----------------------------------------------------
# The token-protected API under /rest/* is now managed from the dashboard:
# Configuration -> REST API (toggle, generate/rotate the key). Changes apply
# immediately, without a restart.
#
# These two values only SEED the settings the first time the server starts
# against a fresh database. After that the dashboard is the source of truth and
# editing them here has no effect — change it in the UI instead.
# The key is sent as "X-API-Key: <key>" or "Authorization: Bearer <key>".
REST_API=false
REST_API_KEY=super-secret-key

# --- Launcher / daemon (run.sh) ---------------------------------------------
# RUN_IN_SCREEN=true detaches the server into a GNU screen session.
# SESSION_NAME is the screen session name. AUTO_INSTALL lets prep.sh try to
# install missing system dependencies automatically.
RUN_IN_SCREEN=false
SESSION_NAME=chrome-fleet
AUTO_INSTALL=false

# --- Browser launch behaviour ------------------------------------------------
# POP_UP_REAL_BROWSER=true forces every local instance to launch a visible GUI
# browser. When false/unset, each instance honours its own launch_mode
# (gui / xvfb / chrome_headless) chosen in the UI.
POP_UP_REAL_BROWSER=false

# Absolute path (or command on PATH) to the Chrome/Chromium binary. If left
# unset the app auto-detects common install locations per OS. Seeds the
# "chrome_bin" config row on first run.
# CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_BIN=/usr/bin/google-chrome-stable

# --- Node binary (run.sh) ----------------------------------------------------
# Override which node binary run.sh uses. Leave unset to auto-resolve from PATH
# and common Homebrew/system locations.
# NODE_BIN=/opt/homebrew/opt/node@22/bin/node

# --- Live tab control tuning -------------------------------------------------
# JPEG quality (10-100) of the streamed screenshots. Higher = sharper but
# larger frames. Defaults to 60.
# SCREENSHOT_QUALITY=60

# How long a single frame capture may take before it is given up on, in ms.
# A capture issued at the moment device emulation changes the page's surface
# can go unanswered by Chrome forever; this is what keeps that from freezing
# the live view. Defaults to 10000.
# SCREENSHOT_TIMEOUT_MS=10000

# The same deadline for every other DevTools command, in ms. Defaults to 30000.
# CDP_COMMAND_TIMEOUT_MS=30000

# --- Network panel -----------------------------------------------------------
# How many requests the per-tab network log keeps. Oldest are dropped first.
# Defaults to 500.
# NETWORK_LOG_MAX=500

# How long a recorder keeps running with nobody reading it, in ms. It holds a
# CDP session open, so it closes itself once the panel stops polling.
# Defaults to 120000.
# NETWORK_LOG_IDLE_MS=120000

# --- Console panel -----------------------------------------------------------
# How many lines the per-tab console transcript keeps. Oldest are dropped first.
# Defaults to 1000.
# CONSOLE_LOG_MAX=1000

# How long a console recorder keeps running with nobody reading it, in ms. It
# holds a CDP session open, so it closes itself once the panel stops polling.
# Defaults to 120000.
# CONSOLE_LOG_IDLE_MS=120000

# How long an expression typed at the prompt may run before it is given up on,
# in ms. Also the deadline for awaiting a promise it returned. Defaults to 15000.
# CONSOLE_EVAL_TIMEOUT_MS=15000

# Chrome replays the console messages it had already buffered when the panel
# attaches, but those arrive without the object previews a live message carries.
# This is how many of them are worth one round trip each to fill in, so a page
# that logged thousands of objects does not turn opening the panel into
# thousands of commands. Defaults to 300; 0 turns it off.
# CONSOLE_PREVIEW_BUDGET=300

# --- Advanced Chrome flags (optional) ---------------------------------------
# Graphics stack for managed instances. Leave this unset: Chrome then picks its
# own renderer, which is both the fastest option and the one that gives the best
# WebGL available on the machine.
#
#   unset  Chrome decides. WebGL works everywhere (real GPU where there is one,
#          SwiftShader where there is not). Fastest capture.
#   1      Force the software SwiftShader stack. Deterministic, but measured at
#          roughly half the capture rate, and it downgrades WebGL to software
#          even on a machine that has a GPU.
#   0      Pass --disable-gpu. Lightest, but WebGL is unavailable.
#
# CHROME_MANAGER_ENABLE_WEBGL=

# Chrome's own log verbosity. Off by default: `--v=1` wrote about 436 KB per
# second under active browsing, roughly 1.5 GB per hour per instance, with
# nothing rotating it. Warnings and errors are still recorded without it.
# Turn it on only while chasing a browser-level bug.
# CHROME_MANAGER_VERBOSE_CHROME_LOG=1

# Ignore TLS certificate errors for EVERY managed browser instance. Intranet
# targets often serve certs from a private/internal CA that Chrome doesn't
# trust, which otherwise blocks the page on "Your connection is not private"
# (ERR_CERT_AUTHORITY_INVALID). Enabled here because this deployment targets an
# internal network. Set to 0 (or remove) if you point the fleet at public sites
# and want normal certificate validation back.
CHROME_MANAGER_IGNORE_CERT_ERRORS=1

# On macOS, GUI instances launch via `open` by default. Set to 0 to spawn the
# Chrome binary directly instead.
# CHROME_MANAGER_DARWIN_USE_OPEN=1

# Legacy global headless toggles (per-instance launch_mode now takes priority).
# CHROME_MANAGER_FORCE_HEADLESS=0
# CHROME_MANAGER_DARWIN_HEADLESS=0
